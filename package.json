{
  "name": "llm-theo",
  "version": "1.4.7-beta.1",
  "shortVersionWindows": "1.4.7.1",
  "description": "An agentic workspace for social-science research.",
  "author": {
    "name": "Shuai Yuan"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "tsx alt-theory-app/web-server/server.ts",
    "dev:web:local": "cross-env ALT_THEORY_MODE=local tsx alt-theory-app/web-server/server.ts",
    "dev:frontend-v6": "npm --prefix alt-theory-app/frontend run dev",
    "build:frontend-v6": "npm --prefix alt-theory-app/frontend run build",
    "start:web": "tsx alt-theory-app/web-server/server.ts",
    "smoke:core": "tsx alt-theory-app/core/test-core.ts",
    "smoke:resume": "tsx alt-theory-app/core/smoke-resume.ts",
    "smoke:backend": "tsx alt-theory-app/web-server/smoke-backend.ts",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "tsx --test alt-theory-app/core/**/*.test.ts alt-theory-app/web-server/**/*.test.ts && tsx --test alt-theory-app/web-server/backend-server.integration.ts",
    "test:models-metadata": "tsx --test alt-theory-app/web-server/models-dev-metadata.slow.ts",
    "test:frontend": "tsx --tsconfig alt-theory-app/frontend/tsconfig.app.json --test alt-theory-app/frontend/src/**/*.test.ts",
    "dev:electron": "electron electron/main.cjs",
    "compile:bundle": "node scripts/compile-bundle.cjs",
    "build:electron": "npm run build:frontend-v6 && npm run compile:bundle && electron-builder build --dir"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.82.0",
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  },
  "build": {
    "buildVersion": "1.4.7.1",
    "appId": "com.alttheory.app",
    "productName": "AltTheory",
    "copyright": "Copyright © 2026 Shuai Yuan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "alt-theory-app/web-server/public-v6/**",
      "dist-bundle/**",
      "package.json",
      "node_modules/**",
      "!node_modules/@mistralai/**",
      "!node_modules/**/node_modules/@mistralai/**"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "agent-assets",
        "to": "agent-assets",
        "filter": [
          "**/*",
          "!**/snapshots/**",
          "!**/experimental/**"
        ]
      },
      {
        "from": "docs/en",
        "to": "docs/en"
      },
      {
        "from": "docs/zh-Hans",
        "to": "docs/zh-Hans"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "electron/assets/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
